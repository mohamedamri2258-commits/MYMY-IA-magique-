class SettingsScreen extends StatefulWidget {
  const SettingsScreen({super.key});

  @override
  State<SettingsScreen> createState() => _SettingsScreenState();
}

class _SettingsScreenState extends State<SettingsScreen> {
  final _urlCtrl = TextEditingController();
  final _userCtrl = TextEditingController();
  String _status = '';

  @override
  void initState() {
    super.initState();
    _load();
  }

  Future<void> _load() async {
    final prefs = await SharedPreferences.getInstance();
    final chat = context.read<ChatProvider>();
    _urlCtrl.text = prefs.getString('api_base') ?? chat.api.baseUrl;
    _userCtrl.text = prefs.getString('user_id') ?? chat.userId;
    setState(() {});
  }

  Future<void> _save() async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setString('api_base', _urlCtrl.text.trim());
    await prefs.setString('user_id', _userCtrl.text.trim());

    // Note: pour appliquer complètement il faut redémarrer l'app
    // car ApiService est créé au démarrage.
    final chat = context.read<ChatProvider>();
    chat.api.setBaseUrl(_urlCtrl.text.trim());
    chat.setUserId(_userCtrl.text.trim());
    await chat.loadProjects();
    setState(() => _status = 'Enregistré et appliqué.');
  }

  Future<void> _test() async {
    setState(() => _status = 'Test en cours…');
    try {
      final api = ApiService(baseUrl: _urlCtrl.text.trim());
      final h = await api.health();
      setState(() => _status = 'OK – ${h['service']} | RAG: ${h['rag_enabled']} | Providers: ${h['providers']}');
    } catch (e) {
      setState(() => _status = 'Erreur : $e');
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Réglages')),
      body: ListView(
        padding: const EdgeInsets.all(16),
        children: [
          const Text(
            'URL du backend',
            style: TextStyle(fontWeight: FontWeight.bold),
          ),
          const SizedBox(height: 4),
          const Text(
            'Émulateur Android : http://10.0.2.2:8000\n'
            'Appareil réel : http://IP-DE-TON-PC:8000',
            style: TextStyle(fontSize: 12, color: Colors.white60),
          ),
          const SizedBox(height: 8),
          TextField(
            controller: _urlCtrl,
            decoration: const InputDecoration(
              border: OutlineInputBorder(),
              hintText: 'http://10.0.2.2:8000',
            ),
          ),
          const SizedBox(height: 16),
          const Text('User ID (mémoire RAG)', style: TextStyle(fontWeight: FontWeight.bold)),
          const SizedBox(height: 8),
          TextField(
            controller: _userCtrl,
            decoration: const InputDecoration(border: OutlineInputBorder()),
          ),
          const SizedBox(height: 24),
          Row(
            children: [
              Expanded(
                child: ElevatedButton(
                  onPressed: _save,
                  child: const Text('Enregistrer'),
                ),
              ),
              const SizedBox(width: 12),
              Expanded(
                child: OutlinedButton(
                  onPressed: _test,
                  child: const Text('Tester connexion'),
                ),
              ),
            ],
          ),
          if (_status.isNotEmpty) ...[
            const SizedBox(height: 16),
            Text(_status, style: const TextStyle(height: 1.4)),
          ],
          const SizedBox(height: 32),
          const Divider(),
          const ListTile(
            leading: Icon(Icons.info_outline),
            title: Text('MYMY-IA Magique'),
            subtitle: Text('Version 1.0.0 – Multi-IA • RAG • Streaming'),
          ),
        ],
      ),
    );
  }
}
import 'dart:io';
