class ToolsScreen extends StatefulWidget {
  const ToolsScreen({super.key});

  @override
  State<ToolsScreen> createState() => _ToolsScreenState();
}

class _ToolsScreenState extends State<ToolsScreen> {
  final _topicCtrl = TextEditingController();
  final _reqCtrl = TextEditingController();
  final _memoryCtrl = TextEditingController();
  String _result = '';
  bool _loading = false;
  String _language = 'python';

  @override
  void dispose() {
    _topicCtrl.dispose();
    _reqCtrl.dispose();
    _memoryCtrl.dispose();
    super.dispose();
  }

  ApiService get _api => context.read<ChatProvider>().api;
  String get _userId => context.read<ChatProvider>().userId;

  Future<void> _run(Future<Map<String, dynamic>> Function() fn) async {
    setState(() {
      _loading = true;
      _result = '';
    });
    try {
      final res = await fn();
      setState(() {
        _result = res['content']?.toString() ??
            res['analysis']?.toString() ??
            res.toString();
      });
    } catch (e) {
      setState(() => _result = 'Erreur : $e');
    } finally {
      setState(() => _loading = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Outils IA')),
      body: ListView(
        padding: const EdgeInsets.all(16),
        children: [
          _section(
            title: '✍️ Article',
            child: Column(
              children: [
                TextField(
                  controller: _topicCtrl,
                  decoration: const InputDecoration(
                    labelText: 'Sujet',
                    border: OutlineInputBorder(),
                  ),
                ),
                const SizedBox(height: 8),
                ElevatedButton(
                  onPressed: _loading
                      ? null
                      : () => _run(() => _api.writeArticle(topic: _topicCtrl.text)),
                  child: const Text('Générer article'),
                ),
              ],
            ),
          ),
          _section(
            title: '💻 Code',
            child: Column(
              children: [
                DropdownButtonFormField<String>(
                  value: _language,
                  decoration: const InputDecoration(border: OutlineInputBorder()),
                  items: const [
                    DropdownMenuItem(value: 'python', child: Text('Python')),
                    DropdownMenuItem(value: 'javascript', child: Text('JavaScript')),
                    DropdownMenuItem(value: 'typescript', child: Text('TypeScript')),
                    DropdownMenuItem(value: 'go', child: Text('Go')),
                  ],
                  onChanged: (v) => setState(() => _language = v ?? 'python'),
                ),
                const SizedBox(height: 8),
                TextField(
                  controller: _reqCtrl,
                  maxLines: 3,
                  decoration: const InputDecoration(
                    labelText: 'Spécifications',
                    border: OutlineInputBorder(),
                  ),
                ),
                const SizedBox(height: 8),
                ElevatedButton(
                  onPressed: _loading
                      ? null
                      : () => _run(() => _api.generateCode(
                            requirements: _reqCtrl.text,
                            language: _language,
                          )),
                  child: const Text('Générer code'),
                ),
              ],
            ),
          ),
          _section(
            title: '📄 Analyser un document',
            child: ElevatedButton.icon(
              icon: const Icon(Icons.upload_file),
              label: const Text('Choisir un fichier (PDF/TXT)'),
              onPressed: _loading
                  ? null
                  : () async {
                      final result = await FilePicker.platform.pickFiles(
                        type: FileType.custom,
                        allowedExtensions: ['pdf', 'txt', 'md', 'png', 'jpg'],
                      );
                      if (result == null || result.files.single.path == null) return;
                      final file = File(result.files.single.path!);
                      await _run(() => _api.analyzeDocument(
                            file: file,
                            userId: _userId,
                          ));
                    },
            ),
          ),
          _section(
            title: '🧠 Mémoire utilisateur',
            child: Column(
              children: [
                TextField(
                  controller: _memoryCtrl,
                  maxLines: 2,
                  decoration: const InputDecoration(
                    labelText: 'Souvenir à enregistrer',
                    border: OutlineInputBorder(),
                  ),
                ),
                const SizedBox(height: 8),
                ElevatedButton(
                  onPressed: _loading
                      ? null
                      : () => _run(() => _api.remember(
                            userId: _userId,
                            content: _memoryCtrl.text,
                          )),
                  child: const Text('Mémoriser'),
                ),
              ],
            ),
          ),
          if (_loading)
            const Padding(
              padding: EdgeInsets.all(24),
              child: Center(child: CircularProgressIndicator()),
            ),
          if (_result.isNotEmpty)
            Card(
              margin: const EdgeInsets.only(top: 16),
              child: Padding(
                padding: const EdgeInsets.all(16),
                child: SelectableText(_result, style: const TextStyle(height: 1.4)),
              ),
            ),
        ],
      ),
    );
  }

  Widget _section({required String title, required Widget child}) {
    return Card(
      margin: const EdgeInsets.only(bottom: 16),
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            Text(title, style: const TextStyle(fontSize: 16, fontWeight: FontWeight.bold)),
            const SizedBox(height: 12),
            child,
          ],
        ),
      ),
    );
  }
}
import 'dart:convert';
import 'dart:io';
import 'package:http/http.dart' as http;
import 'package:web_socket_channel/web_socket_channel.dart';

class ApiService {
  String baseUrl;

  ApiService({required this.baseUrl});

  void setBaseUrl(String value) => baseUrl = value.trim().replaceFirst(RegExp(r'/\$'), '');

  Uri _uri(String path) => Uri.parse('$baseUrl$path');

  String _extractError(http.Response res) {
    try {
      final body = jsonDecode(res.body);
      return body['detail']?.toString() ?? res.body;
    } catch (_) {
      return res.body.isNotEmpty ? res.body : 'HTTP ${res.statusCode}';
    }
  }

  // ---------- Health / Ollama ----------
  Future<Map<String, dynamic>> health() async {
    final res = await http.get(_uri('/api/ai/health'));
    if (res.statusCode >= 400) throw Exception('Backend inaccessible');
    return jsonDecode(res.body) as Map<String, dynamic>;
  }

  Future<List<String>> ollamaModels() async {
    try {
      final res = await http.get(_uri('/api/ai/ollama/models'));
      if (res.statusCode >= 400) return [];
      final data = jsonDecode(res.body) as Map<String, dynamic>;
      final models = data['models'] as List? ?? [];
      return models.map((m) {
        if (m is Map) return (m['name'] ?? '').toString();
        return m.toString();
      }).where((n) => n.isNotEmpty).toList();
    } catch (_) {
      return [];
    }
  }

  // ---------- Chat (AI général) ----------
  Future<Map<String, dynamic>> chat({
    required String message,
    String aiType = 'auto',
    String? model,
    String? userId,
    String? sessionId,
    bool useMemory = true,
  }) async {
    final res = await http.post(
      _uri('/api/ai/chat'),
      headers: {'Content-Type': 'application/json'},
      body: jsonEncode({
        'message': message,
        'ai_type': aiType,
        if (model != null) 'model': model,
        'user_id': userId ?? 'anonymous',
        'session_id': sessionId,
        'use_memory': useMemory,
      }),
    );
    if (res.statusCode >= 400) throw Exception(_extractError(res));
    return jsonDecode(res.body) as Map<String, dynamic>;
  }

  // ---------- Chat projet ----------
  Future<Map<String, dynamic>> chatInProject({
    required String message,
    String? projectId,
    String? conversationId,
    String aiType = 'auto',
    String? model,
    bool useMemory = true,
  }) async {
    final res = await http.post(
      _uri('/api/projects/chat'),
      headers: {'Content-Type': 'application/json'},
      body: jsonEncode({
        'message': message,
        'project_id': projectId,
        'conversation_id': conversationId,
        'ai_type': aiType,
        if (model != null) 'model': model,
        'use_memory': useMemory,
      }),
    );
    if (res.statusCode >= 400) throw Exception(_extractError(res));
    return jsonDecode(res.body) as Map<String, dynamic>;
  }

  WebSocketChannel connectChatWs() {
    final wsUrl = baseUrl.replaceFirst(RegExp(r'^http'), 'ws');
    return WebSocketChannel.connect(Uri.parse('$wsUrl/api/ai/ws/chat'));
  }

  // ---------- Projets ----------
  Future<List<dynamic>> listProjects() async {
    final res = await http.get(_uri('/api/projects'));
    if (res.statusCode >= 400) throw Exception(_extractError(res));
    return jsonDecode(res.body) as List<dynamic>;
  }

  Future<Map<String, dynamic>> createProject({
    required String name,
    String description = '',
    String icon = '📁',
  }) async {
    final res = await http.post(
      _uri('/api/projects'),
      headers: {'Content-Type': 'application/json'},
      body: jsonEncode({'name': name, 'description': description, 'icon': icon}),
    );
    if (res.statusCode >= 400) throw Exception(_extractError(res));
    return jsonDecode(res.body) as Map<String, dynamic>;
  }

  Future<List<dynamic>> listConversations(String projectId) async {
    final res = await http.get(_uri('/api/projects/$projectId/conversations'));
    if (res.statusCode >= 400) throw Exception(_extractError(res));
    return jsonDecode(res.body) as List<dynamic>;
  }

  Future<List<dynamic>> getMessages(String conversationId) async {
    final res = await http.get(_uri('/api/projects/conversations/$conversationId/messages'));
    if (res.statusCode >= 400) throw Exception(_extractError(res));
    return jsonDecode(res.body) as List<dynamic>;
  }

  Future<List<dynamic>> listFiles(String projectId) async {
    final res = await http.get(_uri('/api/projects/$projectId/files'));
    if (res.statusCode >= 400) throw Exception(_extractError(res));
    return jsonDecode(res.body) as List<dynamic>;
  }

  Future<Map<String, dynamic>> uploadFile({
    required String projectId,
    required File file,
  }) async {
    final request = http.MultipartRequest('POST', _uri('/api/projects/$projectId/files'));
    request.files.add(await http.MultipartFile.fromPath('file', file.path));
    final streamed = await request.send();
    final res = await http.Response.fromStream(streamed);
    if (res.statusCode >= 400) throw Exception(_extractError(res));
    return jsonDecode(res.body) as Map<String, dynamic>;
  }

  // ---------- Outils ----------
  Future<Map<String, dynamic>> writeArticle({
    required String topic,
    String style = 'professionnel',
    int length = 800,
  }) async {
    final res = await http.post(
      _uri('/api/ai/write/article'),
      headers: {'Content-Type': 'application/json'},
      body: jsonEncode({'topic': topic, 'style': style, 'length': length}),
    );
    if (res.statusCode >= 400) throw Exception(_extractError(res));
    return jsonDecode(res.body) as Map<String, dynamic>;
  }

  Future<Map<String, dynamic>> generateCode({
    required String requirements,
    String language = 'python',
  }) async {
    final res = await http.post(
      _uri('/api/ai/write/code'),
      headers: {'Content-Type': 'application/json'},
      body: jsonEncode({'requirements': requirements, 'language': language}),
    );
    if (res.statusCode >= 400) throw Exception(_extractError(res));
    return jsonDecode(res.body) as Map<String, dynamic>;
  }

  Future<Map<String, dynamic>> analyzeDocument({
    required File file,
    String userId = 'anonymous',
    String? question,
    bool storeInRag = true,
  }) async {
    final request = http.MultipartRequest('POST', _uri('/api/ai/analyze/document'));
    request.fields['user_id'] = userId;
    request.fields['store_in_rag'] = storeInRag.toString();
    if (question != null && question.isNotEmpty) {
      request.fields['question'] = question;
    }
    request.files.add(await http.MultipartFile.fromPath('file', file.path));
    final streamed = await request.send();
    final res = await http.Response.fromStream(streamed);
    if (res.statusCode >= 400) throw Exception(_extractError(res));
    return jsonDecode(res.body) as Map<String, dynamic>;
  }

  Future<Map<String, dynamic>> remember({
    required String userId,
    required String content,
    String memoryType = 'preference',
  }) async {
    final res = await http.post(
      _uri('/api/ai/memory/remember'),
      headers: {'Content-Type': 'application/json'},
      body: jsonEncode({
        'user_id': userId,
        'content': content,
        'memory_type': memoryType,
      }),
    );
    if (res.statusCode >= 400) throw Exception(_extractError(res));
    return jsonDecode(res.body) as Map<String, dynamic>;
  }
}
import 'dart:convert';
import 'package:flutter/foundation.dart';
import 'package:web_socket_channel/web_socket_channel.dart';
import 'api_service.dart';

class ChatMessage {
  final String role;
  final String content;
  final DateTime time;

  ChatMessage({required this.role, required this.content, DateTime? time})
      : time = time ?? DateTime.now();
}

class ChatProvider extends ChangeNotifier {
  final ApiService api;
  String userId;
  String? sessionId;
  String? projectId;
  String? conversationId;
  String aiType;
  String? ollamaModel;
  List<String> ollamaModels;
  bool useStreaming;

  final List<ChatMessage> messages = [];
  List<Map<String, dynamic>> projects = [];
  String streamingBuffer = '';
  bool isLoading = false;
  String? error;

  WebSocketChannel? _ws;

  ChatProvider({
    required this.api,
    required this.userId,
    this.aiType = 'auto',
    this.useStreaming = false,
  }) : ollamaModels = [];

  Future<void> init() async {
    await loadProjects();
    await loadOllamaModels();
  }

  Future<void> loadProjects() async {
    try {
      final list = await api.listProjects();
      projects = list.map((e) => Map<String, dynamic>.from(e as Map)).toList();
      notifyListeners();
    } catch (e) {
      debugPrint('loadProjects: $e');
    }
  }

  Future<void> loadOllamaModels() async {
    try {
      ollamaModels = await api.ollamaModels();
      if (ollamaModels.isNotEmpty && (ollamaModel == null || ollamaModel!.isEmpty)) {
        ollamaModel = ollamaModels.first;
      }
      notifyListeners();
    } catch (_) {}
  }

  Future<void> createProject(String name, {String description = ''}) async {
    final p = await api.createProject(name: name, description: description);
    projects.insert(0, p);
    projectId = p['id'] as String?;
    conversationId = null;
    messages.clear();
    notifyListeners();
  }

  void selectProject(String? id) {
    projectId = id;
    conversationId = null;
    messages.clear();
    sessionId = null;
    notifyListeners();
  }

  void setUserId(String id) {
    userId = id;
    notifyListeners();
  }

  void setAiType(String type) {
    aiType = type;
    notifyListeners();
  }

  void setOllamaModel(String? m) {
    ollamaModel = m;
    notifyListeners();
  }

  void setUseStreaming(bool v) {
    useStreaming = v;
    notifyListeners();
  }

  Future<void> sendMessage(String text) async {
    if (text.trim().isEmpty || isLoading) return;

    messages.add(ChatMessage(role: 'user', content: text.trim()));
    isLoading = true;
    error = null;
    streamingBuffer = '';
    notifyListeners();

    try {
      if (useStreaming && projectId == null) {
        await _sendViaWebSocket(text.trim());
      } else {
        await _sendViaHttp(text.trim());
      }
    } catch (e) {
      error = e.toString();
      isLoading = false;
      notifyListeners();
    }
  }

  Future<void> _sendViaHttp(String text) async {
    Map<String, dynamic> res;
    if (projectId != null) {
      res = await api.chatInProject(
        message: text,
        projectId: projectId,
        conversationId: conversationId,
        aiType: aiType,
        model: aiType == 'ollama' ? ollamaModel : null,
      );
      conversationId = res['conversation_id'] as String?;
    } else {
      res = await api.chat(
        message: text,
        aiType: aiType,
        model: aiType == 'ollama' ? ollamaModel : null,
        userId: userId,
        sessionId: sessionId,
      );
      sessionId = res['session_id'] as String?;
    }

    messages.add(ChatMessage(
      role: 'assistant',
      content: res['content'] as String? ?? '',
    ));
    isLoading = false;
    notifyListeners();
  }

  Future<void> _sendViaWebSocket(String text) async {
    _ws?.sink.close();
    _ws = api.connectChatWs();

    _ws!.sink.add(jsonEncode({
      'message': text,
      'ai_type': aiType,
      if (aiType == 'ollama' && ollamaModel != null) 'model': ollamaModel,
      'user_id': userId,
      'session_id': sessionId,
      'use_memory': true,
    }));

    String full = '';
    await for (final raw in _ws!.stream) {
      final data = jsonDecode(raw as String) as Map<String, dynamic>;
      final type = data['type'] as String?;

      if (type == 'start') {
        sessionId = data['session_id'] as String?;
      } else if (type == 'chunk') {
        full += data['content'] as String? ?? '';
        streamingBuffer = full;
        notifyListeners();
      } else if (type == 'done') {
        messages.add(ChatMessage(role: 'assistant', content: full));
        streamingBuffer = '';
        isLoading = false;
        notifyListeners();
        _ws?.sink.close();
        break;
      } else if (type == 'error') {
        error = data['content'] as String? ?? 'Erreur WebSocket';
        isLoading = false;
        notifyListeners();
        _ws?.sink.close();
        break;
      }
    }
  }

  void clearChat() {
    messages.clear();
    sessionId = null;
    conversationId = null;
    streamingBuffer = '';
    error = null;
    notifyListeners();
  }

  @override
  void dispose() {
    _ws?.sink.close();
    super.dispose();
  }
}
