# Example environment variables for Magique IA backend (Unified Cloud / Local)

# MODE: 'cloud' (OpenAI) or 'local' (Ollama + sentence-transformers)
MODE=cloud

# OpenAI (used when MODE=cloud)
OPENAI_API_KEY=your_openai_api_key_here
EMBED_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Ollama (used when MODE=local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama-3
LOCAL_EMBED_MODEL=all-MiniLM-L6-v2

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=magique_projects

# Embedding vector size (set 1536 for OpenAI text-embedding-3-small, 384 for MiniLM)
EMBED_VECTOR_SIZE=1536

# Storage
STORAGE_PATH=./storage
